{
  "manifest_version": 3,
  "name": "当前域名 Cookie 管理器",
  "version": "1.0.0",
  "description": "导出当前网站域名的 Cookie 文件，并在同一域名导入复用登录态。",
  "action": {
    "default_title": "Cookie 管理器",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
